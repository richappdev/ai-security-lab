# Copy this file to .env before starting the lab.
#
# Keep these bind addresses on 127.0.0.1 unless you are intentionally exposing
# the lab to another trusted machine on an isolated network.

JUICE_SHOP_BIND=127.0.0.1
JUICE_SHOP_PORT=3000

DVWA_BIND=127.0.0.1
DVWA_PORT=8080

SECURITY_APP_BIND=127.0.0.1
SECURITY_APP_PORT=8000

POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=aisec
POSTGRES_PASSWORD=aisec
POSTGRES_DB=aisec
DATABASE_URL=postgresql+psycopg://aisec:aisec@127.0.0.1:5432/aisec

# Optional local OIDC (docker compose --profile oidc up)
# Imports deploy/keycloak/aisec-realm.json (users alice/alice-pass, bob/bob-pass)
KEYCLOAK_BIND=127.0.0.1
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_ISSUER=http://127.0.0.1:8081/realms/aisec
OIDC_AUDIENCE=aisec-api
OIDC_JWKS_URL=http://127.0.0.1:8081/realms/aisec/protocol/openid-connect/certs
OIDC_CLIENT_ID=aisec-ui
ALLOW_DEV_AUTH=true

# Private Beta (docker compose --profile beta up)
USE_DURABLE_RUNS=true
TEMPORAL_HOST=
TEMPORAL_BIND=127.0.0.1
TEMPORAL_PORT=7233
EVIDENCE_SIGNING_KEY=local-dev-evidence-key
MINIO_BIND=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_BIND=127.0.0.1
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=
MINIO_BUCKET=evidence
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Optional CI publishers for release gates
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITLAB_TOKEN=
GITLAB_PROJECT_ID=
GITLAB_BASE_URL=https://gitlab.com

# Partner beta safety profile
DEPLOYMENT_ENV=local
ALLOW_LEGACY_SYNC_RUNS=true
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agent-security-evaluations
TEMPORAL_TLS=false
# Hosted beta: base64-encoded raw 32-byte Ed25519 private key.
EVIDENCE_SIGNING_ALGORITHM=hmac-sha256
EVIDENCE_ED25519_PRIVATE_KEY=
EVIDENCE_SIGNING_KEY_ID=
CAPABILITY_ED25519_PRIVATE_KEY=
CAPABILITY_SIGNING_KEY_ID=
EVIDENCE_SENSITIVE_FIELDS=
EVIDENCE_SEEDED_SECRETS=
# Fernet key for organization-scoped integration credentials.
INTEGRATION_ENCRYPTION_KEY=
OPERATIONS_TOKEN=
